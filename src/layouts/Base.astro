---
// Stub layout. Ticket #19 finalizes the navigation; ticket #15 owns the design.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} — ayvbrg.log</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">ayvbrg.log</a>
        <a href="/log/">Log</a>
        <a href="/faq/">FAQ</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <style is:global>
      :root {
        color-scheme: light dark;
        font-family: system-ui, sans-serif;
        line-height: 1.6;
      }
      body {
        margin: 0 auto;
        max-width: 42rem;
        padding: 2rem 1rem;
      }
      nav {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
      }
      pre {
        overflow-x: auto;
      }
    </style>
  </body>
</html>
