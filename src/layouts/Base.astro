---
// The inline script below is the whole JavaScript budget for an ordinary page:
// it applies the stored theme before first paint and runs the toggle.
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} — ayvbrg.log</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let saved = null;
        try {
          saved = localStorage.getItem('mode');
        } catch {}
        if (saved === 'dark' || saved === 'light') root.dataset.mode = saved;
        // Marks the toggle usable: without this it never leaves display:none.
        root.dataset.js = '';

        const query = matchMedia('(prefers-color-scheme: dark)');
        const mode = () => root.dataset.mode || (query.matches ? 'dark' : 'light');

        document.addEventListener('DOMContentLoaded', () => {
          const button = document.querySelector('.theme-toggle');
          const sync = () => button.setAttribute('aria-pressed', String(mode() === 'dark'));
          button.addEventListener('click', () => {
            const next = mode() === 'dark' ? 'light' : 'dark';
            root.dataset.mode = next;
            try {
              localStorage.setItem('mode', next);
            } catch {}
            sync();
          });
          // Keeps the reported state honest when the OS theme changes mid-session.
          query.addEventListener('change', sync);
          sync();
        });
      })();
    </script>
  </head>
  <body>
    <div class="motes" aria-hidden="true">
      <span style="left: 12%; animation-duration: 19s; animation-delay: -2s"></span>
      <span style="left: 26%; animation-duration: 24s; animation-delay: -9s"></span>
      <span style="left: 41%; animation-duration: 21s; animation-delay: -14s"></span>
      <span style="left: 58%; animation-duration: 27s; animation-delay: -4s"></span>
      <span style="left: 73%; animation-duration: 18s; animation-delay: -11s"></span>
      <span style="left: 87%; animation-duration: 23s; animation-delay: -6s"></span>
    </div>
    <div class="arch" aria-hidden="true"></div>

    <header>
      <nav>
        <a class="mark" href="/"><b>ayvbrg</b>.log</a>
        <a href="/log/">Log</a>
        <a href="/faq/">FAQ</a>
        <button class="theme-toggle" type="button" aria-label="Dark theme">
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <circle cx="8" cy="8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.1"></circle>
            <path d="M8 1.6a6.4 6.4 0 0 0 0 12.8Z" fill="currentColor"></path>
          </svg>
        </button>
      </nav>
    </header>

    <main><slot /></main>

    <style>
      body {
        max-width: 44rem;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 5rem;
      }

      main {
        min-width: 0;
        /* 600 ms content reveal, CSS-only: no script gates the content. */
        animation: reveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      @keyframes reveal {
        from {
          opacity: 0;
          transform: translateY(9px);
        }
      }

      header {
        position: relative;
        margin-bottom: 3rem;
        padding-bottom: 1.1rem;
        border-bottom: 1px solid var(--line);
      }

      /* Crest-like linework: a single ornament riding the header rule. */
      header::after {
        content: '';
        position: absolute;
        left: 50%;
        bottom: -3.5px;
        width: 6px;
        height: 6px;
        border: 1px solid var(--acc);
        border-radius: 50%;
        background: var(--bg);
        outline: 1px solid color-mix(in srgb, var(--acc) 12%, transparent);
        outline-offset: 3px;
        transform: translateX(-50%);
      }

      nav {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        font-size: 0.875rem;
        color: var(--dim);
      }

      nav a {
        text-decoration: underline;
        text-decoration-color: transparent;
        text-underline-offset: 4px;
        transition: color 0.2s, text-decoration-color 0.3s;
      }

      nav a:hover {
        color: var(--ink);
        text-decoration-color: var(--acc);
      }

      .mark {
        margin-right: auto;
        font-size: 0.9375rem;
        color: var(--ink);
      }

      .mark b {
        color: var(--acc);
        font-weight: 500;
      }

      .theme-toggle {
        display: none;
        padding: 0.25rem;
        border: 0;
        background: transparent;
        color: var(--faint);
        border-radius: 4px;
        cursor: pointer;
        transition: color 0.2s, background 0.2s;
      }

      /* Only shown once the inline script is running; it is the toggle. */
      :root[data-js] .theme-toggle {
        display: flex;
      }

      .theme-toggle:hover {
        color: var(--ink);
        background: var(--elevated);
      }

      .theme-toggle svg {
        width: 16px;
        height: 16px;
      }

      /* Drifting motes: very slow, sparse, decorative only. */
      .motes {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        pointer-events: none;
      }

      .motes span {
        position: absolute;
        bottom: -6px;
        width: 2px;
        height: 2px;
        border-radius: 50%;
        background: var(--acc);
        opacity: 0;
        animation-name: rise;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
      }

      @keyframes rise {
        0% {
          transform: translateY(0);
          opacity: 0;
        }
        12% {
          opacity: 0.55;
        }
        80% {
          opacity: 0.35;
        }
        100% {
          transform: translateY(-102vh);
          opacity: 0;
        }
      }

      /* A sparse arch, kept out of the reading column. */
      .arch {
        position: fixed;
        right: 3.5vw;
        top: 13vh;
        z-index: -1;
        width: 112px;
        height: 196px;
        color: color-mix(in srgb, var(--acc) 34%, transparent);
        border: 1px solid currentColor;
        border-bottom: 0;
        border-radius: 68px 68px 0 0;
        opacity: 0.52;
        pointer-events: none;
      }

      .arch::before {
        content: '';
        position: absolute;
        inset: 16px 21px 0;
        border: 1px solid currentColor;
        border-bottom: 0;
        border-radius: 48px 48px 0 0;
      }

      /* No room beside the reading column on a phone. */
      @media (max-width: 820px) {
        .arch {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .motes {
          display: none;
        }
      }
    </style>
  </body>
</html>
