---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline>
      // Theme bootstrap: uses persisted manual override first, otherwise OS preference.
      // Also kept intentionally minimal so ordinary pages ship only this inline JS.
      (() => {
        const STORAGE_KEY = "ayvbrg.log.theme";
        const root = document.documentElement;

        let saved = null;
        try {
          saved = localStorage.getItem(STORAGE_KEY);
        } catch {
          // Ignore storage failures; fall back to OS preference.
        }

        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme =
          saved === "light" || saved === "dark"
            ? saved
            : prefersDark
              ? "dark"
              : "light";

        root.dataset.theme = theme;
        root.style.colorScheme = theme;

        const btn = document.getElementById("theme-toggle");
        if (!btn) return;

        const syncButton = () => {
          const isLight = root.dataset.theme === "light";
          btn.setAttribute("aria-pressed", String(isLight));
          btn.setAttribute(
            "aria-label",
            isLight ? "Use dark theme" : "Use light theme",
          );
          btn.textContent = isLight ? "Theme: Light" : "Theme: Dark";
        };

        syncButton();

        btn.addEventListener("click", () => {
          const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
          try {
            localStorage.setItem(STORAGE_KEY, nextTheme);
          } catch {
            // Ignore storage failures.
          }
          root.dataset.theme = nextTheme;
          root.style.colorScheme = nextTheme;
          syncButton();
        });
      })();
    </script>
  </head>
  <body>
    <div class="motes" aria-hidden="true">
      <span class="mote" style="left: 12%; animation-duration: 19s; animation-delay: -2s" />
      <span class="mote" style="left: 26%; animation-duration: 24s; animation-delay: -9s" />
      <span class="mote" style="left: 41%; animation-duration: 21s; animation-delay: -14s" />
      <span class="mote" style="left: 58%; animation-duration: 27s; animation-delay: -4s" />
      <span class="mote" style="left: 73%; animation-duration: 18s; animation-delay: -11s" />
      <span class="mote" style="left: 87%; animation-duration: 23s; animation-delay: -6s" />
    </div>

    <header>
      <nav aria-label="Primary">
        <a href="/">ayvbrg.log</a>
        <a href="/log/">Log</a>
        <button
          id="theme-toggle"
          type="button"
          aria-label="Theme"
          aria-pressed="false"
        >
          Theme
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
