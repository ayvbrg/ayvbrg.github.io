---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const site = Astro.site ? Astro.site.toString() : null;
const canonicalURL = site ? new URL(Astro.url.pathname, site) : null;
const desc =
  description ||
  "Ayushman Buragohain's log of dev work, experiments, side quests, and occasional thoughts.";
const path = Astro.url.pathname;
const onLog = path === "/log/" || path.startsWith("/log/");
const onFaq = path === "/faq/" || path === "/faq";
const onTags = path.startsWith("/tags/");
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    {canonicalURL ? <link rel="canonical" href={canonicalURL.href} /> : null}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    {canonicalURL ? <meta property="og:url" content={canonicalURL.href} /> : null}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline>
      (() => {
        const STORAGE_KEY = "ayvbrg.log.theme";
        const root = document.documentElement;

        let saved = null;
        try {
          saved = localStorage.getItem(STORAGE_KEY);
        } catch {}

        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const theme =
          saved === "light" || saved === "dark"
            ? saved
            : prefersDark
              ? "dark"
              : "light";

        root.dataset.theme = theme;
        root.style.colorScheme = theme;

        let btn = document.getElementById("theme-toggle");

        const syncButton = () => {
          if (!btn) return;
          const isLight = root.dataset.theme === "light";
          btn.setAttribute("aria-pressed", String(isLight));
          btn.setAttribute(
            "aria-label",
            isLight ? "Use dark mode" : "Use light mode",
          );
          btn.setAttribute(
            "title",
            isLight ? "Use dark mode" : "Use light mode",
          );
          const glyph = btn.querySelector("[data-theme-glyph]");
          if (glyph) glyph.textContent = isLight ? "☾︎" : "☼︎";
        };

        const bindButton = () => {
          btn = document.getElementById("theme-toggle");
          if (!btn) return;
          syncButton();
          if (btn.dataset.themeBound === "1") return;
          btn.dataset.themeBound = "1";
          btn.addEventListener("click", () => {
            const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
            try {
              localStorage.setItem(STORAGE_KEY, nextTheme);
            } catch {}
            root.dataset.theme = nextTheme;
            root.style.colorScheme = nextTheme;
            syncButton();
          });
        };

        bindButton();
        if (!btn) window.addEventListener("DOMContentLoaded", bindButton);

        const bootReveal = () => {
          const nodes = document.querySelectorAll(".reveal");
          const show = (el) => el.classList.add("in");
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            nodes.forEach(show);
            return;
          }
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  show(entry.target);
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.08 },
          );
          nodes.forEach((el) => io.observe(el));
        };
        if (document.readyState === "loading") {
          window.addEventListener("DOMContentLoaded", bootReveal);
        } else {
          bootReveal();
        }
      })();
    </script>
  </head>
  <body>
    <svg class="sprite" aria-hidden="true">
      <symbol id="i-github" viewBox="0 0 24 24"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></symbol>
      <symbol id="i-x" viewBox="0 0 24 24"><path d="M3.5 3 L20.5 21"></path><path d="M20.5 3 L13.8 10.2"></path><path d="M10.2 13.8 L3.5 21"></path></symbol>
      <symbol id="i-kaggle" viewBox="0 0 24 24"><path d="M6.8 2.5 V21.5"></path><path d="M18.4 6 C13.4 8.4 9.4 11 6.8 13.6"></path><path d="M10.6 10.8 C13.4 14.4 16.2 18 18.4 21.5"></path></symbol>
      <symbol id="i-mail" viewBox="0 0 24 24"><rect x="2.5" y="5" width="19" height="14" rx="2"></rect><path d="M3 6.5 L12 13.5 L21 6.5"></path></symbol>
      <symbol id="i-rss" viewBox="0 0 24 24"><path d="M4 11 a9 9 0 0 1 9 9"></path><path d="M4 4.5 a15.5 15.5 0 0 1 15.5 15.5"></path><circle cx="4.8" cy="19.2" r="1.4"></circle></symbol>
      <symbol id="g-mask" viewBox="0 0 24 24"><path d="M8 10 C6.6 6.4 6 4.6 5.2 2.6 C7 4 8.4 5.8 9.4 8.4"></path><path d="M16 10 C17.4 6.4 18 4.6 18.8 2.6 C17 4 15.6 5.8 14.6 8.4"></path><path d="M12 8.6 C7.8 8.6 6.4 11.8 6.9 15.5 C7.4 19.2 9.7 21.5 12 22 C14.3 21.5 16.6 19.2 17.1 15.5 C17.6 11.8 16.2 8.6 12 8.6 Z"></path><path d="M12 9.2 V17"></path></symbol>
      <symbol id="g-diamond" viewBox="0 0 24 24"><path d="M12 3 L20 12 L12 21 L4 12 Z"></path></symbol>
      <symbol id="g-tome" viewBox="0 0 24 24"><path d="M3.5 4.5 C6.8 3.4 9.4 3.8 12 5.6 C14.6 3.8 17.2 3.4 20.5 4.5 V19 C17.2 17.9 14.6 18.3 12 20 C9.4 18.3 6.8 17.9 3.5 19 Z"></path><path d="M12 5.6 V20"></path></symbol>
      <symbol id="g-lantern" viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="13" rx="3"></rect><path d="M10.4 9.2 L14.8 11.5 L10.4 13.8 Z"></path></symbol>
      <symbol id="g-quill" viewBox="0 0 24 24"><path d="M20.5 3.5 C13 4.5 8 8.5 6.2 14.5 L4 20.5"></path><path d="M6.2 14.5 C11.5 15 15.8 12.2 18 6.8"></path><path d="M6.6 17.6 H12"></path></symbol>
    </svg>
    <div class="motes" aria-hidden="true">
      <span class="mote" style="left: 12%; animation-duration: 19s; animation-delay: -2s"></span>
      <span class="mote" style="left: 26%; animation-duration: 24s; animation-delay: -9s"></span>
      <span class="mote" style="left: 41%; animation-duration: 21s; animation-delay: -14s"></span>
      <span class="mote" style="left: 58%; animation-duration: 27s; animation-delay: -4s"></span>
      <span class="mote" style="left: 73%; animation-duration: 18s; animation-delay: -11s"></span>
      <span class="mote" style="left: 87%; animation-duration: 23s; animation-delay: -6s"></span>
    </div>
    <div class="theme-el motif-hallownest" aria-hidden="true"></div>

    <div class="shell">
      <aside class="rail">
        <div class="mark">
          <a href="/" class="home">
            <svg viewBox="0 0 28 28" aria-hidden="true">
              <path d="M10 12 C8.5 8 8 6 7 3.5 C9 5 10.5 7 11.5 10"></path>
              <path d="M18 12 C19.5 8 20 6 21 3.5 C19 5 17.5 7 16.5 10"></path>
              <path d="M14 10.5 C9.5 10.5 8 14 8.5 18 C9 22 11.5 24.5 14 25 C16.5 24.5 19 22 19.5 18 C20 14 18.5 10.5 14 10.5 Z"></path>
              <line x1="14" y1="11" x2="14" y2="20"></line>
            </svg>
            <span class="wm"><b>ayvbrg</b>.log</span>
          </a>
          <button
            class="mode-toggle"
            id="theme-toggle"
            type="button"
            aria-label="Use light mode"
            title="Use light mode"
            aria-pressed="false"
          >
            <span data-theme-glyph aria-hidden="true">☼︎</span>
          </button>
        </div>
        <nav class="rn" aria-label="Primary">
          <a href="/log/" class={onLog && !onTags ? "on" : undefined}>
            <svg class="nav-i" aria-hidden="true"><use href="#g-quill" /></svg>
            the log
          </a>
          <a href="/#shelf">
            <svg class="nav-i" aria-hidden="true"><use href="#g-tome" /></svg>
            shelf
          </a>
          <a href="/tags/" class={onTags ? "on" : undefined}>
            <svg class="nav-i" aria-hidden="true"><use href="#g-diamond" /></svg>
            tags
          </a>
          <a href="/faq/" class={onFaq ? "on" : undefined}>
            <svg class="nav-i" aria-hidden="true"><use href="#g-mask" /></svg>
            faq
          </a>
        </nav>
      </aside>

      <main class="main">
        <div class="reveal in">
          <slot />
        </div>
        <div class="colophon">
          <svg viewBox="0 0 130 16" aria-hidden="true">
            <path d="M2 8 H46"></path>
            <path d="M118 8 H84"></path>
            <path d="M46 8 C54 1 60 15 65 8 C70 1 76 15 84 8"></path>
            <path d="M65 2 V14"></path>
            <path d="M60 4.5 L65 8 L70 4.5"></path>
          </svg>
          <span class="c">© 2026 Ayushman Buragohain · <a href="https://github.com/ayvbrg/ayvbrg.github.io">source on GitHub</a></span>
        </div>
      </main>
    </div>
    <noscript>
      <style>
        .reveal {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
  </body>
</html>
