---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publicEntries, formatUtcDate, utcDateKey, chipClass } from "../../lib/log";
import "../../styles/content.css";

export async function getStaticPaths() {
  const entries = await publicEntries();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const pubDate = utcDateKey(entry.data.pubDate);
const updatedDate = entry.data.updated
  ? utcDateKey(entry.data.updated)
  : null;
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="entry">
    <a class="back" href="/log/">← Back to Log</a>
    <h1>{entry.data.title}</h1>
    <p class="meta" data-pub-date={pubDate}>{formatUtcDate(entry.data.pubDate)}</p>

    {updatedDate ? (
      <p class="meta" data-updated-date={updatedDate}>
        Updated: {formatUtcDate(entry.data.updated!)}
      </p>
    ) : null}

    <div class="tags" data-tags>
      {entry.data.tags.map((tag: string) => (
        <a href={`/tags/${tag}/`} class={chipClass(tag)}>{tag}</a>
      ))}
    </div>

    <div class="entry-body">
      <Content />
    </div>

    <script is:inline>
      document.querySelectorAll(".entry-body pre").forEach((pre) => {
        const btn = document.createElement("button");
        btn.className = "copy-btn";
        btn.textContent = "copy";
        btn.setAttribute("aria-label", "Copy code to clipboard");
        btn.addEventListener("click", () => {
          const code = pre.querySelector("code");
          if (code) {
            navigator.clipboard.writeText(code.textContent || "").then(() => {
              btn.textContent = "copied";
              setTimeout(() => {
                btn.textContent = "copy";
              }, 1500);
            });
          }
        });
        pre.appendChild(btn);
      });
    </script>

    <footer class="foot">
      <a href="mailto:aburagohain160@gmail.com">aburagohain160@gmail.com</a>
      <a href="/rss.xml">RSS</a>
      <a href="/log/">← Back to Log</a>
    </footer>
  </article>
</BaseLayout>
