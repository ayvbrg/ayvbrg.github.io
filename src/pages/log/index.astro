---
import { publicEntries } from "../../lib/log";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entries = await publicEntries();
---

<BaseLayout title="Log — ayvbrg.log">
  <h1>Log</h1>

  <div id="search">
    <label for="search-input">Search</label>
    <input
      id="search-input"
      type="search"
      placeholder="Search entries…"
      autocomplete="off"
    />
    <div id="search-results" aria-live="polite"></div>
  </div>

  <ul id="entry-list">
    {
      entries.map((entry) => (
        <li data-entry-id={entry.id} data-pub-date={entry.data.pubDate.toISOString().slice(0, 10)}>
          <a href={`/log/${entry.id}/`}>{entry.data.title}</a>
          <time>{entry.data.pubDate.toISOString().slice(0, 10)}</time>
          <p class="summary">{entry.data.summary}</p>
          <ul class="tags">
            {entry.data.tags.map((t: string) => (
              <li><a href={`/tags/${t}/`}>{t}</a></li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>

  <noscript>
    <p>Search requires JavaScript. Browse the full list above or use <a href="/tags/devlog/">devlog</a>, <a href="/tags/experiment/">experiment</a>, or <a href="/tags/random/">random</a> Tag links.</p>
  </noscript>

  <script is:inline>
    async function initSearch() {
      const input = document.getElementById("search-input");
      const resultsDiv = document.getElementById("search-results");
      const entryList = document.getElementById("entry-list");
      if (!input) return;

      const pagefind = await import("/pagefind/pagefind.js");
      await pagefind.init();

      input.addEventListener("input", async () => {
        const query = input.value.trim();
        if (!query) {
          resultsDiv.innerHTML = "";
          entryList.style.display = "";
          return;
        }
        entryList.style.display = "none";
        const search = await pagefind.search(query);
        if (search.results.length === 0) {
          resultsDiv.innerHTML = `<p>No results for "${query}". Try <a href="/tags/devlog/">devlog</a>, <a href="/tags/experiment/">experiment</a>, or <a href="/tags/random/">random</a>.</p>`;
          return;
        }
        const items = await Promise.all(search.results.slice(0, 20).map((r: any) => r.data()));
        resultsDiv.innerHTML = "<ul>" + items.map((item: any) =>
          `<li><a href="${item.url}">${item.meta?.title ?? item.url}</a><p>${item.excerpt}</p></li>`
        ).join("") + "</ul>";
      });
    }
    initSearch();
  </script>
</BaseLayout>
