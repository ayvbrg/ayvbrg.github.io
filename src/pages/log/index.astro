---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publicEntries } from "../../lib/log";

const entries = await publicEntries();
---

<BaseLayout title="Log">
  <h1>Log</h1>
  <ul>
    {
      entries.map((entry) => (
        <li data-entry-id={entry.id}>
          <a href={`/log/${entry.id}/`}>{entry.data.title}</a>
          <p class="pub-date" data-pub-date={entry.data.pubDate.toISOString().slice(0, 10)}>
            {entry.data.pubDate.toISOString().slice(0, 10)}
          </p>
          <p class="summary" data-summary>
            {entry.data.summary}
          </p>
          <ul class="tags" data-tags>
            {entry.data.tags.map((tag: string) => (
              <li>
                <a href={`/tags/${tag}/`}>{tag}</a>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</BaseLayout>
