---
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { publicEntries } from '../../lib/log';

// Only Tags carrying at least one public Entry get a page.
export async function getStaticPaths() {
  const entries = await publicEntries();
  return [...new Set(entries.flatMap((entry) => entry.data.tags))].map((tag) => ({
    params: { tag },
    props: { tag, entries: entries.filter((entry) => entry.data.tags.includes(tag)) },
  }));
}

const { tag, entries } = Astro.props;
---

<Base title={`Tag: ${tag}`}>
  <h1>{tag}</h1>
  <EntryList entries={entries} />
</Base>
