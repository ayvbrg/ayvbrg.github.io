---
import { publicEntries } from "../../lib/log";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const entries = await publicEntries();
  const tags = [...new Set(entries.flatMap((e) => e.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      entries: entries.filter((e) => e.data.tags.includes(tag)),
    },
  }));
}

const { tag, entries } = Astro.props;
---

<BaseLayout title={`${tag} — ayvbrg.log`}>
  <h1>{tag}</h1>
  <p><a href="/log/">Back to Log</a></p>
  <ul>
    {
      entries.map((entry) => (
        <li data-entry-id={entry.id} data-pub-date={entry.data.pubDate.toISOString().slice(0, 10)}>
          <a href={`/log/${entry.id}/`}>{entry.data.title}</a>
          <time>{entry.data.pubDate.toISOString().slice(0, 10)}</time>
          <p class="summary">{entry.data.summary}</p>
          <ul class="tags">
            {entry.data.tags.map((t: string) => (
              <li><a href={`/tags/${t}/`}>{t}</a></li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</BaseLayout>
